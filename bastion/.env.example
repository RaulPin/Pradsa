# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...            # service_role: SOLO en el servidor

# === Sesión (JWT HS256) ===
# Genera uno con: openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# === Correo (Resend) — opcional en desarrollo ===
# Si no se configura, los códigos OTP se imprimen en consola.
RESEND_API_KEY=
EMAIL_FROM=Bastión <no-reply@example.com>

# URL pública de la app (para correos)
NEXT_PUBLIC_APP_URL=http://localhost:3000
